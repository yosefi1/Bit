# =========================================================================
# Database
# -------------------------------------------------------------------------
# Local development (default): SQLite, zero setup required.
DATABASE_URL="file:./dev.db"

# Production (Vercel + Supabase/Neon/Postgres): use a pooled connection string.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"   # used by prisma migrate

# =========================================================================
# NextAuth
# -------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# =========================================================================
# Bit Payment Integration
# -------------------------------------------------------------------------
# These are seeded into the database on first run; admins can edit them
# from the Settings page later. Override here only if you want non-default
# values on first boot.
BIT_PHONE="0500000000"
BIT_RECIPIENT_NAME="Apartment Owner"

# =========================================================================
# OCR
# -------------------------------------------------------------------------
# The app uses Tesseract.js by default (free, runs on the server, no API key).
# If you set OPENAI_API_KEY, meter images will additionally be analyzed by
# GPT-4o-mini vision for higher accuracy. Tesseract remains the fallback.
# OPENAI_API_KEY="sk-..."

# =========================================================================
# File storage
# -------------------------------------------------------------------------
# "local"  -> save uploads in /public/uploads (great for local dev)
# "vercel-blob" -> use Vercel Blob (set BLOB_READ_WRITE_TOKEN). Implementation
#                  is stubbed; uncomment in src/lib/storage.ts when deploying.
STORAGE_DRIVER="local"
# BLOB_READ_WRITE_TOKEN=""

# =========================================================================
# Seed admin (used once when running `npm run db:seed`)
# -------------------------------------------------------------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Site Administrator"
